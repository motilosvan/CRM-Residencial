# Copiar a .env (ignorado por git) y reemplazar cada <cambiar> por un valor propio.
# Las contraseñas de SQL Server exigen mayúscula, minúscula, número y símbolo (8+ caracteres).
MSSQL_SA_PASSWORD=<cambiar>
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CorreosCRM
# DB_ENCRYPT=true             # por defecto: true salvo en localhost
# DB_TRUST_SERVER_CERT=false  # por defecto: true solo en localhost

# Identidad del MIGRADOR: aplica DDL, crea la BD y el login de la aplicación.
DB_MIGRATOR_USER=sa
DB_MIGRATOR_PASSWORD=<la misma de MSSQL_SA_PASSWORD>

# Identidad de la APLICACIÓN: rol crm_app (sin DELETE, sin ALTER, historial solo inserción).
# `npm run db:migrate` crea este login si no existe.
DB_USER=soc_app
DB_PASSWORD=<cambiar>

# Gateway IMAP (Gmail con contraseña de aplicación)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
