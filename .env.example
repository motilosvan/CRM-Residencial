# Copiar a .env (ignorado por git) y reemplazar cada <cambiar> por un valor propio.
# Las contraseñas de SQL Server exigen mayúscula, minúscula, número y símbolo (8+ caracteres).
MSSQL_SA_PASSWORD=<cambiar>
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CorreosCRM
# DB_ENCRYPT=true             # por defecto: true salvo en localhost
# DB_TRUST_SERVER_CERT=false  # por defecto: true solo en localhost

# Identidad del MIGRADOR: aplica DDL, crea la BD y el login de la aplicación.
DB_MIGRATOR_USER=sa
DB_MIGRATOR_PASSWORD=<la misma de MSSQL_SA_PASSWORD>

# Identidad de la APLICACIÓN: rol crm_app (sin DELETE, sin ALTER, historial solo inserción).
# `npm run db:migrate` crea este login si no existe.
DB_USER=soc_app
DB_PASSWORD=<cambiar>

# Gateway IMAP (Gmail con contraseña de aplicación) — `npm run gateway`
# 1) Active la verificación en 2 pasos de la cuenta. 2) Cree una contraseña de aplicación en
#    https://myaccount.google.com/apppasswords y péguela aquí (con o sin espacios).
# Recomendado: una cuenta dedicada al conjunto, no un correo personal (todo lo leído se guarda en la BD).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_INTERVALO_S=45          # segundos entre lecturas
# IMAP_DIAS_INICIALES=7        # primera lectura: solo los últimos N días (0 = solo hoy)
# IMAP_MAX_POR_CICLO=50
# IMAP_MAX_INTENTOS=3          # fallos de un correo antes de guardarlo SIN_CLASIFICAR
# IMAP_MARCAR_LEIDO=false      # true = marcar leído en Gmail tras guardarlo

# API HTTP (`npm run api`), solo en 127.0.0.1. El panel (apps/web) la usa vía el proxy de Vite.
# API_PORT=3000

# Sugerencias de IA (`npm run ia`). Apagado por defecto: sin IA el sistema funciona con reglas.
# Solo sugiere: nunca cambia una solicitud. El texto se enmascara antes de enviarse, pero el enmascarado es
# por patrones y puede dejar pasar datos. Antes de usarlo con correos reales, revise la Ley 1581.
# IA_PROVEEDOR: ninguno | openrouter | opencode-go
# Modelo predeterminado: xing4.0 gratuito en OpenRouter (se satura a ratos) y glm-5.3-flash en OpenCode Go.
IA_PROVEEDOR=ninguno
# Llave de https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Llave de la consola de OpenCode
OPENCODE_API_KEY=
# IA_MODELO=glm-5.3-flash      # debe aceptar esquema JSON y no entrenar con los datos
# IA_INTERVALO_S=60
# IA_MAX_POR_CICLO=5
# IA_PAUSA_ENTRE_S=10          # los proveedores gratuitos limitan las ráfagas
# IA_MAX_INTENTOS=3            # respuestas inválidas antes de dejar solo las reglas
# IA_ESPERA_REINTENTO_MIN=30
# IA_TIMEOUT_S=60
