{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/api/**/*.ts", "apps/gateway/**/*.ts", "apps/worker-ia/**/*.ts", "vitest.config.ts", "eslint.config.js"]
}
