{
  "name": "crm-residencial",
  "version": "0.2.0",
  "private": true,
  "description": "SOC-CRM: Sistema Organizador de Correos y Capa CRM Residencial (backend/ + frontend/)",
  "engines": { "node": ">=20" },
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:migrate": "npm --prefix backend run db:migrate",
    "lint": "npm --prefix backend run lint",
    "typecheck": "npm --prefix backend run typecheck",
    "test": "npm --prefix backend test",
    "gate": "npm --prefix backend run gate",
    "demo": "npm --prefix backend run demo",
    "gateway": "npm --prefix backend run gateway",
    "api": "npm --prefix backend run api",
    "ia": "npm --prefix backend run ia",
    "web": "npm --prefix frontend run dev --",
    "web:install": "npm --prefix frontend install"
  }
}
